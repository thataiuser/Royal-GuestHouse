# MongoDB Atlas or local. Leave empty to run with in-memory storage (bookings are lost on restart).
MONGODB_URI=
PORT=3000
# Password for the admin page (/#/admin). Admin is disabled if empty.
ADMIN_PASSWORD=change-this-password
# Long random string used to sign the admin login cookie
JWT_SECRET=
# Set to true when served over HTTPS
COOKIE_SECURE=false
# false (default): any dates are bookable as long as they do not overlap an existing booking.
# true: a room can only be booked from the check-out day of its latest booking onwards.
STRICT_AFTER_LAST=false
# Shown on the website
GUESTHOUSE_PHONE=+237 600 000 000
GUESTHOUSE_EMAIL=reservations@royalguesthouse.example
GUESTHOUSE_ADDRESS=Add your address here

# ---------------- Mobile-money payments ----------------
# off    : only "pay on arrival"
# manual : guest sends MTN MoMo / Orange Money to the numbers below; staff mark the booking as paid in the admin page
# campay : automatic MTN MoMo and Orange Money collection through CamPay (campay.net)
# mock   : demo provider that "succeeds" after 6 seconds (testing only)
PAYMENT_PROVIDER=off
# Unpaid online bookings release their dates after this many minutes
PAY_HOLD_MINUTES=60
MOMO_NUMBER=
ORANGE_NUMBER=
MOMO_ACCOUNT_NAME=Royal Guesthouse
# CamPay: use the demo URL while testing, https://campay.net/api for live payments
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=

# ---------------- Email and SMS notifications ----------------
# Leave SMTP_HOST / SMS_PROVIDER empty to print messages in the server console instead (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Royal Guesthouse <no-reply@yourdomain.com>"
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Phone numbers without a country code get this one (Cameroon = 237)
DEFAULT_COUNTRY_CODE=237
# Staff get a copy of every booking, payment and cancellation
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=

# ---- Email provider ----
# Leave empty to auto-detect: SMTP when SMTP_HOST is set, otherwise emails are only printed in the terminal.
# MAIL_PROVIDER=brevo   -> sends over HTTPS with BREVO_API_KEY  (works even when SMTP ports are blocked)
# MAIL_PROVIDER=resend  -> sends over HTTPS with RESEND_API_KEY (works even when SMTP ports are blocked)
MAIL_PROVIDER=
BREVO_API_KEY=
RESEND_API_KEY=
# Test your email settings any time with:  node scripts/mail-test.js you@example.com
